FROM scratch
ADD x86_64/5c135f6e69f5d4b63999a40a0de4fe14e71cf0f5982baf9c8b7573f872e9133a.tar.xz /
ADD x86_64/65f564da1b95d3c84b0cf13b3396050c0099da048bec7a7ff0d3a63c202565c2.tar.xz /
ADD x86_64/94eaa6a49f496c8d7f80d58ebaadefca05fb77299b8e9d31575fc4ddd3ac3b5b.tar.xz /
ADD x86_64/af10a4ac26763f031bba53c5fb81f3fbb39591755fd102d29e7fc36f4257c9e9.tar.xz /
ADD x86_64/b8e7b055736408bec2a93ac84bb051cc687c7a781d7b141a1b2f542bcdb74048.tar.xz /
ADD x86_64/c2fabad3460b8d6359e3dc6ea2fcc2b3e4d124abb8e2dfb3e8e10f68a421a65d.tar.xz /
ADD x86_64/e1bb2b19d9b49073ebfe72b889468339804344bbed99d4ee4f644466efff4506.tar.xz /
ADD x86_64/f5df463a4732b763111e7696c4aa98ff97cfe2b416488f23601ecd7cc00729c8.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.19
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
